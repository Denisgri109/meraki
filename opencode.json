{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--access-token",
        "${SUPABASE_ACCESS_TOKEN}"
      ],
      "enabled": true
    },
    "TestSprite": {
      "type": "local",
      "command": [
        "npx",
        "@testsprite/testsprite-mcp@latest"
      ],
      "environment": {
        "API_KEY": "${TESTSPRITE_API_KEY}"
      },
      "enabled": true
    }
  }
}
