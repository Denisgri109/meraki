# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - add it to .gitignore

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://bkxdsxnxrtcqnkdcdist.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Configuration (for payments)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here

# Resend API Key (for email notifications in edge functions)
# This goes in Supabase Edge Function Secrets, not here
# RESEND_API_KEY=your_resend_key_here

# Other API Keys
# EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
# EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here
