{
  "expo": {
    "name": "Merakí",
    "slug": "meraki-app",
    "version": "1.0.0",
    "scheme": "meraki",
    "orientation": "portrait",
    "icon": "./public/logo512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meraki.app",
      "infoPlist": {
        "NFCReaderUsageDescription": "This app uses NFC to pair loyalty stamp tags",
        "LSApplicationQueriesSchemes": [
          "meraki"
        ]
      },
      "associatedDomains": [
        "applinks:meraki.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.meraki.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "meraki",
              "host": "loyalty"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./public/favicon.ico"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan QR codes."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.meraki.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./public/logo512.png",
          "color": "#8B5CF6",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-nfc-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "207c1f34-1b9c-4772-9a7d-b157e557d1ef"
      }
    }
  }
}